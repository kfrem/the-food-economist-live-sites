# Hostinger runtime configuration must remain on the server.
# The two files below are credential-free bridges to the existing Hostinger
# runtime configuration. All other API configuration remains untracked.
**/api/config.php
!epr/api/config.php
!myprofit/api/config.php
**/.env
**/.env.*

# Runtime submissions are server data, not release source.
**/api/booking-data/*
!**/api/booking-data/.htaccess

# Local/editor artefacts.
.DS_Store
Thumbs.db
*.log
